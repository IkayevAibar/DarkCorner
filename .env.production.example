# Copy to /opt/darkcorner/.env on the server and fill in. Never commit the real file.
# After changing it, run `docker compose up -d` (a restart does not re-read .env).

POSTGRES_USER=darkcorner
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=dark_corner

# Generate: openssl rand -hex 32
SESSION_SECRET=
PUBLIC_WEB_URL=https://dark.ugolok.world

# Copy from the hub's .env (/opt/ugolok/.env) — must be identical.
SSO_SECRET=
ACCOUNT_ORIGIN=https://account.ugolok.world

# Your Discord user ID (Discord → Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID).
ADMIN_DISCORD_IDS=

# Discord channel → Edit channel → Integrations → Webhooks → New webhook → Copy URL. Blank = Broadcasts only logged.
DISCORD_WEBHOOK_URL=

SERVER_TIMEZONE=Asia/Almaty

# Where Caddy reaches the web app (docker bridge, not public).
WEB_BIND=172.17.0.1
WEB_PORT=8089
API_HOST_PORT=4002
