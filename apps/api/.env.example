# Copy to .env for local development. Nothing here is a real secret.
NODE_ENV=development
API_PORT=4100
DATABASE_URL=postgresql://dark:dark@localhost:5433/dark_corner?schema=public

# Signs this site's own cookie (the local dev session). Any 16+ characters.
SESSION_SECRET=local-dev-session-secret

# Where the web app is served; cookies are marked Secure when this is https.
PUBLIC_WEB_URL=http://localhost:5180

# Leave blank locally: you get the dev login instead of the ugolok.world hub.
# In production this must equal SSO_SECRET in the hub's .env (32+ characters).
SSO_SECRET=
ACCOUNT_ORIGIN=http://localhost:5175

# Comma-separated Discord IDs that are admins (approved automatically).
ADMIN_DISCORD_IDS=

# Discord channel webhook for Broadcasts. Blank = Broadcasts are only logged.
DISCORD_WEBHOOK_URL=

SERVER_TIMEZONE=Asia/Almaty

# Push notifications' key pair (npx web-push generate-vapid-keys). Blank = the API
# makes a pair once and keeps it in the database, which is fine for most setups.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
