// Terms follow CONTEXT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A person with a Discord account. Must be approved before creating a Hero.
model Player {
  id         String    @id @default(cuid())
  /// Discord snowflake from the hub's SSO cookie; `dev-…` for local dev logins.
  discordId  String    @unique
  username   String
  globalName String?
  /// Discord avatar hash, not a URL.
  avatar     String?
  /// Null until the Player picks a language; until then the browser's is used.
  locale     String?
  isAdmin    Boolean   @default(false)
  approvedAt DateTime?
  bannedAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  feedEvents FeedEvent[]
  rolls      RollLog[]
  heroes     Hero[]
  drafts     HeroDraft[]
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  FINALE
  ENDED
}

/// One cycle of play: a fresh Labyrinth, a Boss, a Wipe at the end.
model Season {
  id         String       @id @default(cuid())
  number     Int          @unique
  /// Seeds the Labyrinth generator; kept so the whole Labyrinth can be rebuilt.
  seed       String
  status     SeasonStatus @default(PLANNED)
  startsAt   DateTime?
  bossGateAt DateTime?
  finaleAt   DateTime?
  endedAt    DateTime?
  createdAt  DateTime     @default(now())

  feedEvents FeedEvent[]
  heroes     Hero[]
  drafts     HeroDraft[]
  items      Item[]
}

/// A Player's character for one Season. A retired Hero stays, marked retiredAt.
model Hero {
  id          String    @id @default(cuid())
  playerId    String
  seasonId    String
  name        String
  race        String
  class       String
  talents     String[]
  portrait    String
  banner      String
  level       Int       @default(1)
  xp          Int       @default(0)
  str         Int
  dex         Int
  con         Int
  int         Int
  wis         Int
  cha         Int
  maxHp       Int
  hp          Int
  /// Safe in the City.
  gold        Int       @default(0)
  /// Picked up on the current Run; lost on death, banked on reaching the City.
  carriedGold Int       @default(0)
  stamina     Int
  /// When `stamina` was last worked out; refills are counted from here.
  staminaAt   DateTime  @default(now())
  retiredAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  items  Item[]

  @@index([playerId, seasonId])
}

/// Ability sets rolled while creating a Hero. One per Player per Season at a
/// time, so abandoning the screen can't fish for better rolls.
model HeroDraft {
  id          String   @id @default(cuid())
  playerId    String
  seasonId    String
  /// AbilitySet[] from the engine, in the order rolled.
  sets        Json
  rerollsLeft Int
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId])
}

enum ItemPlace {
  WORN
  BAG
  STORAGE
}

/// One Item, or one stack of a stackable. Exactly one place at a time.
model Item {
  id         String    @id @default(cuid())
  seasonId   String
  heroId     String?
  place      ItemPlace
  /// Worn Items only: main, off, head, body, hands, feet, amulet, ring1, ring2.
  slot       String?
  base       String
  tier       String
  quantity   Int       @default(1)
  itemLevel  Int       @default(1)
  quality    Int?
  /// [{ stat, value }] from the engine's GearRoll.
  bonusStats Json      @default("[]")
  suffix     Int?
  uniqueId   String?
  radiant    Boolean   @default(false)
  identified Boolean   @default(true)
  upgrade    Int       @default(0)
  /// Relic copy number within the Season.
  serial     Int?
  /// Relic owner history: display names, oldest first.
  owners     Json?
  /// The seed that rolled this Item, for the roll log.
  seed       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  hero   Hero?  @relation(fields: [heroId], references: [id], onDelete: SetNull)

  @@index([heroId, place])
  @@unique([heroId, slot])
}

/// Every roll that matters, with the seed that produced it, so it can be replayed.
model RollLog {
  id        BigInt   @id @default(autoincrement())
  playerId  String?
  /// What was rolled: "abilities", "drop", "forge", "chest", "deathSave", …
  kind      String
  seed      String
  detail    Json
  createdAt DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@index([kind, createdAt])
}

/// Work scheduled for later (Boss gate, weakening, Vault openings). Idempotent.
model Job {
  id        String    @id @default(cuid())
  kind      String
  runAt     DateTime
  payload   Json      @default("{}")
  doneAt    DateTime?
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

/// A line in the Tavern's Feed. Some also become Broadcasts.
model FeedEvent {
  id        BigInt   @id @default(autoincrement())
  seasonId  String?
  playerId  String?
  kind      String
  data      Json
  createdAt DateTime @default(now())

  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
