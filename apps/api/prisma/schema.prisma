// Terms follow CONTEXT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Server-wide switches an admin flips on the admin page, e.g. whether the gate
/// lets everyone in (key "gate", value { open: boolean }).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A person with a Discord account. Must be approved before creating a Hero.
model Player {
  id         String    @id @default(cuid())
  /// Discord snowflake from the hub's SSO cookie; `dev-…` for local dev logins.
  discordId  String    @unique
  username   String
  globalName String?
  /// Discord avatar hash, not a URL.
  avatar     String?
  /// Null until the Player picks a language; until then the browser's is used.
  locale     String?
  isAdmin    Boolean   @default(false)
  approvedAt DateTime?
  bannedAt   DateTime?
  /// Updated at most once a minute, for "who's online" in the Tavern.
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  feedEvents FeedEvent[]
  rolls      RollLog[]
  heroes     Hero[]
  drafts     HeroDraft[]
  listings   Listing[]
}

enum SeasonStatus {
  PLANNED
  ACTIVE
  FINALE
  ENDED
}

/// One cycle of play: a fresh Labyrinth, a Boss, a Wipe at the end.
model Season {
  id         String       @id @default(cuid())
  number     Int          @unique
  /// Seeds the Labyrinth generator; kept so the whole Labyrinth can be rebuilt.
  seed       String
  status     SeasonStatus @default(PLANNED)
  startsAt   DateTime?
  bossGateAt DateTime?
  finaleAt   DateTime?
  endedAt    DateTime?
  createdAt  DateTime     @default(now())

  feedEvents FeedEvent[]
  heroes     Hero[]
  drafts     HeroDraft[]
  items      Item[]
}

/// A Player's character for one Season. A retired Hero stays, marked retiredAt.
model Hero {
  id          String    @id @default(cuid())
  playerId    String
  seasonId    String
  name        String
  race        String
  class       String
  talents     String[]
  /// The Path chosen at level 3; null before.
  path        String?
  /// Growth chosen at levels 4, 8, 12, 16 and 19: [{ level, kind, ... }] (engine: Growth).
  growths     Json      @default("[]")
  portrait    String
  banner      String
  level       Int       @default(1)
  xp          Int       @default(0)
  str         Int
  dex         Int
  con         Int
  int         Int
  wis         Int
  cha         Int
  maxHp       Int
  hp          Int
  /// When `hp` last healed with time in the Labyrinth; recovery is counted from here.
  hpAt        DateTime  @default(now())
  /// Safe in the City.
  gold        Int       @default(0)
  /// Picked up on the current Run; lost on death, banked on reaching the City.
  carriedGold Int       @default(0)
  stamina     Int
  /// When `stamina` was last worked out; refills are counted from here.
  staminaAt   DateTime  @default(now())
  retiredAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Where the Hero is. In the City `floor` and `room` are null.
  location    HeroLocation @default(CITY)
  floor       Int?
  room        Int?
  /// The last safe Room: no monsters left in it. Retreating, escaping and surviving Death saves end here.
  prevRoom    Int?
  /// Standing in a Room with monsters not fought yet: it must Fight, Sneak past or Retreat before going on.
  facing      Boolean      @default(false)
  /// How the Hero fights: bold, steady or wary.
  stance      String       @default("steady")
  bestFloor   Int          @default(0)
  /// A Town Portal left open behind the Hero: one step back through from the City, until `portalUntil`.
  portalFloor Int?
  portalRoom  Int?
  portalUntil DateTime?
  /// Floors whose Waypoint the Hero has reached.
  waypoints   Int[]        @default([])
  /// Uses left until the next long rest.
  spellUses   Int          @default(0)
  healUses    Int          @default(0)
  /// Once-per-Run powers still available (Deathless Mail).
  deathless   Boolean      @default(true)
  /// Once-per-Run reroll of a failed d20 (Lucky charm, Luckstone).
  lucky       Boolean      @default(true)
  /// When the Hero sat down in a Camp; four hours later it is fully rested.
  campSince   DateTime?
  /// Short rests left: half of full health and Stamina back each (docs/design.md → Moving and stamina).
  shortRests   Int       @default(2)
  /// When the short rests last came back: a Run brings them back no sooner than 8 hours later.
  shortRestsAt DateTime?
  /// Nights taken at the Tavern this Season: each costs more than the last.
  tavernNights Int       @default(0)
  /// When the Hero last took Lodging: one night a day, the day counted in UTC.
  lodgedAt     DateTime?
  /// What the Run under way has brought so far, summed up on the way home (services/runs.ts).
  run          Json?
  /// Deeds (docs/design.md → Deeds and Titles): what each one counts so far, and the Deeds done (id → when).
  deedCounts   Json      @default("{}")
  deeds        Json      @default("{}")
  /// The Title the Player chose to wear: a done Deed's id.
  title        String?

  // Luck
  /// The Bad-luck meter: at 120 the next Item that drops is Legendary or better.
  badLuck       Int       @default(0)
  blessing      String?
  blessingUntil DateTime?

  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season    Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  items     Item[]
  floors    HeroFloor[]
  graves    Grave[]
  purchases ShopPurchase[]
  visits    EventVisit[]
  bounties  Bounty[]

  @@index([playerId, seasonId])
}

enum HeroLocation {
  CITY
  LABYRINTH
}

/// What one Hero knows about one Floor: its Map, and which Rooms it cleared when.
model HeroFloor {
  id      String @id @default(cuid())
  heroId  String
  floor   Int
  /// Room ids the Hero has stood in.
  seen    Int[]  @default([])
  /// { "<roomId>": "<ISO time cleared>" }; a cleared fight Room stays empty for that Hero for a day.
  cleared Json   @default("{}")

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, floor])
}

/// Everything a dead Hero carried, lying where it fell. Anyone may loot it for 48 hours.
model Grave {
  id        String   @id @default(cuid())
  seasonId  String
  floor     Int
  room      Int
  heroId    String?
  ownerName String
  gold      Int      @default(0)
  createdAt DateTime @default(now())
  expiresAt DateTime

  hero  Hero?  @relation(fields: [heroId], references: [id], onDelete: SetNull)
  items Item[]

  @@index([seasonId, floor, room])
}

/// First come, first served: a defeated Mini-boss or an opened Vault, for everyone.
model SpecialClaim {
  id        String   @id @default(cuid())
  seasonId  String
  floor     Int
  room      Int
  heroId    String
  claimedAt DateTime @default(now())

  @@unique([seasonId, floor, room])
}

/// Ability sets rolled while creating a Hero. One per Player per Season at a
/// time, so abandoning the screen can't fish for better rolls.
model HeroDraft {
  id          String   @id @default(cuid())
  playerId    String
  seasonId    String
  /// AbilitySet[] from the engine, in the order rolled.
  sets        Json
  rerollsLeft Int
  createdAt   DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId])
}

enum ItemPlace {
  WORN
  BAG
  STORAGE
  GRAVE
  MARKET
}

/// One Item, or one stack of a stackable. Exactly one place at a time.
model Item {
  id         String    @id @default(cuid())
  seasonId   String
  heroId     String?
  place      ItemPlace
  /// Worn Items only: main, off, head, body, hands, feet, amulet, ring1, ring2.
  slot       String?
  base       String
  tier       String
  quantity   Int       @default(1)
  itemLevel  Int       @default(1)
  quality    Int?
  /// [{ stat, value }] from the engine's GearRoll.
  bonusStats Json      @default("[]")
  suffix     Int?
  uniqueId   String?
  radiant    Boolean   @default(false)
  identified Boolean   @default(true)
  upgrade    Int       @default(0)
  /// Relic copy number within the Season.
  serial     Int?
  /// Relic owner history: display names, oldest first.
  owners     Json?
  /// The seed that rolled this Item, for the roll log.
  seed       String?
  graveId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  season  Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  hero    Hero?    @relation(fields: [heroId], references: [id], onDelete: SetNull)
  grave   Grave?   @relation(fields: [graveId], references: [id], onDelete: Cascade)
  listing Listing?

  @@index([heroId, place])
  @@unique([heroId, slot])
}

/// An Item for sale on the Market. While listed the Item's place is MARKET and it
/// belongs to no Hero; the row goes away when it sells or is taken back.
model Listing {
  id         String   @id @default(cuid())
  seasonId   String
  itemId     String   @unique
  /// The selling Player: proceeds go to whichever Hero they have when it sells.
  sellerId   String
  sellerName String
  price      Int
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  seller Player @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([seasonId, expiresAt])
  @@index([sellerId])
}

/// Today's Shop gear a Hero has bought: each piece sells once per Hero per day.
model ShopPurchase {
  id     String @id @default(cuid())
  heroId String
  /// Days since the epoch, UTC.
  day    Int
  offer  String

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, day, offer])
}

/// One Hero's visit to an Event room on one day: what the Hero did there. The
/// room's contents come from a seed, so only progress is stored.
model EventVisit {
  id        String    @id @default(cuid())
  heroId    String
  floor     Int
  room      Int
  /// Days since the epoch, UTC: events restock daily, like fight Rooms.
  day       Int
  kind      String
  state     Json      @default("{}")
  doneAt    DateTime?
  createdAt DateTime  @default(now())

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, floor, room, day])
}

/// Every roll that matters, with the seed that produced it, so it can be replayed.
model RollLog {
  id        BigInt   @id @default(autoincrement())
  playerId  String?
  /// What was rolled: "abilities", "drop", "forge", "chest", "deathSave", …
  kind      String
  seed      String
  detail    Json
  createdAt DateTime @default(now())

  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([playerId, createdAt])
  @@index([kind, createdAt])
}

/// A place on the Boss podium: 1 is the Champion, 2 and 3 are won in the Finale.
model BossKill {
  id        String   @id @default(cuid())
  seasonId  String
  playerId  String
  heroId    String
  heroName  String
  place     Int
  createdAt DateTime @default(now())

  @@unique([seasonId, place])
  @@unique([seasonId, playerId])
}

/// A Relic copy found this Season; serials count from 1 per design and never repeat.
model RelicFind {
  id        String   @id @default(cuid())
  seasonId  String
  uniqueId  String
  serial    Int
  playerId  String
  heroName  String
  itemId    String?
  source    String
  createdAt DateTime @default(now())

  @@unique([seasonId, uniqueId, serial])
}

/// An announced Vault: sealed until `opensAt`, then the first Hero in claims it.
model VaultOpening {
  id          String    @id @default(cuid())
  seasonId    String
  floor       Int
  room        Int
  opensAt     DateTime
  announcedAt DateTime  @default(now())
  claimedAt   DateTime?
  heroId      String?

  @@index([seasonId, floor, room])
}

/// Glory: what survives every Wipe. Names are copied, so entries outlive Heroes.
model HallEntry {
  id           String   @id @default(cuid())
  seasonNumber Int
  /// champion, second, third, relic, deepest, highest-level
  kind         String
  playerId     String?
  playerName   String
  heroName     String
  detail       Json     @default("{}")
  createdAt    DateTime @default(now())

  @@index([seasonNumber])
}

/// Work scheduled for later (Boss gate, weakening, Vault openings). Idempotent.
model Job {
  id        String    @id @default(cuid())
  kind      String
  runAt     DateTime
  payload   Json      @default("{}")
  doneAt    DateTime?
  attempts  Int       @default(0)
  lastError String?
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

/// A line in the Tavern's Feed. Some also become Broadcasts.
model FeedEvent {
  id        BigInt   @id @default(autoincrement())
  seasonId  String?
  playerId  String?
  kind      String
  data      Json
  createdAt DateTime @default(now())

  season Season? @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  player Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

/// A Tavern bounty: three a day and one a week per Hero (docs/design.md → Tavern bounties).
/// What each one asks comes from a seed per Hero and day; the row keeps its progress.
model Bounty {
  id        String    @id @default(cuid())
  heroId    String
  /// Days since the epoch, UTC: the day of a daily bounty, or the Monday of a weekly one.
  day       Int
  weekly    Boolean   @default(false)
  slot      Int
  kind      String
  target    Int
  progress  Int       @default(0)
  params    Json      @default("{}")
  /// { gold, item: { base, quantity } | null }, paid the moment it is done.
  reward    Json
  doneAt    DateTime?
  /// Swapped for another today; each Hero may swap one bounty a day.
  swapped   Boolean   @default(false)
  createdAt DateTime  @default(now())

  hero Hero @relation(fields: [heroId], references: [id], onDelete: Cascade)

  @@unique([heroId, day, weekly, slot])
}


/// The week's Hunt: the whole server against one kin of monster (docs/design.md → The Hunt).
model Hunt {
  id        String       @id @default(cuid())
  seasonId  String
  /// The Monday it began, as a day number (days since 1970-01-01, UTC).
  week      Int
  kin       String
  target    Int
  total     Int          @default(0)
  doneAt    DateTime?
  createdAt DateTime     @default(now())
  hunters   HuntHunter[]

  @@unique([seasonId, week])
}

/// One Hero's kills in a Hunt.
model HuntHunter {
  id       String @id @default(cuid())
  huntId   String
  heroId   String
  heroName String
  count    Int    @default(0)
  hunt     Hunt   @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, heroId])
  @@index([huntId, count])
}
